{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storage-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "storage", "start", "--", "--port", "4200"],
      "port": 4200,
      "autoPort": false
    },
    {
      "name": "storage-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "storage-api", "run", "start:dev"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
