# ============================================================
# Storage API — biến môi trường (theo PLAN_NO_DEPLOY.md)
# Copy sang .env và điền giá trị thật. KHÔNG commit .env.
# ============================================================

# --- App ---
PORT=3000
NODE_ENV=development
# Origin của Angular app để bật CORS (phân tách bằng dấu phẩy nếu nhiều)
WEB_ORIGIN=http://localhost:4200

# --- Supabase / Postgres (Prisma kết nối trực tiếp, mục 3) ---
# Connection string Postgres của Supabase (Project Settings → Database → Connection string → URI)
# QUAN TRỌNG: app đang chạy (NestJS, nhiều query ngắn/giây) PHẢI trỏ vào
# Transaction pooler (cổng 6543, kèm pgbouncer=true) — KHÔNG dùng Session pooler
# (cổng 5432) cho DATABASE_URL. Session mode giữ 1 connection Postgres riêng cho
# suốt vòng đời client; trên máy nhiều core, Prisma mặc định mở tới
# (số CPU * 2 + 1) connection/tiến trình, vượt ngay pool_size mặc định của
# Supabase (thường 15) và báo lỗi "max clients reached in session mode" chỉ sau
# vài request song song hoặc vài lần restart dev server không thoát sạch.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?schema=public&pgbouncer=true&connection_limit=5&pool_timeout=20
# Dùng cho `prisma migrate`/`db push` — CẦN connection trực tiếp (không qua
# transaction pooler) để chạy DDL + advisory lock, nên giữ cổng 5432.
DIRECT_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public

# --- Supabase Auth (JWT verify — mục 3) ---
# Project Settings → API → JWT Secret (symmetric HS256)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Dùng cho tra auth.users theo email khi mời chia sẻ (mục 12.I) + Realtime publish
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Cloudflare R2 (S3-compatible — mục 5.F) ---
R2_ACCOUNT_ID=your-account-id
R2_BUCKET=storage-app
R2_REGION=auto
# Để trống -> tự dựng https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
# ĐỂ TRỐNG (mục 12.B): không bật Public Development URL -> mọi đường đọc là presigned
R2_PUBLIC_BASE_URL=

# --- Redis / BullMQ (mục 5.B) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Giới hạn & rate limit (mục 5.D) ---
MAX_FILE_SIZE_MB=2048
CHUNK_SIZE_MB=8
# 'on' để bật throttler theo user id; mặc định tắt cho route đã đăng nhập
RATE_LIMIT=off

# --- Thùng rác (mục 7.E) ---
TRASH_RETENTION_DAYS=30

# --- Quét virus tệp thực thi (.exe…) bằng VirusTotal API v3 ---
# Lấy key MIỄN PHÍ tại https://www.virustotal.com/gui/join-us (Profile → API Key).
# Để trống -> app vẫn CẢNH BÁO khi tải .exe nhưng BỎ QUA bước quét thật.
VIRUSTOTAL_API_KEY=
# Trần dung lượng gửi bytes lên VT phân tích tệp lạ (free tier 32MB).
VIRUSTOTAL_MAX_UPLOAD_MB=32
# Thời gian tối đa (ms) chờ VT phân tích xong 1 tệp lạ.
VIRUSTOTAL_TIMEOUT_MS=90000

# --- Chia sẻ (mục 12.B, 12.G) ---
SHARE_CONTENT_TTL_SECONDS=600
# backend dựng URL đầy đủ trả cho dialog (thường trùng WEB_ORIGIN)
SHARE_BASE_URL=http://localhost:4200
# ký token phiên khi mở khoá mật khẩu link chia sẻ
SHARE_SESSION_SECRET=change-me-to-a-long-random-string

# --- AI: embedding + OCR (mục 8) ---
# Lấy tại https://aistudio.google.com/apikey — PHẢI là key Gemini thật (dạng
# "AIzaSy..."), không phải key BazaarLink/proxy khác dán nhầm vào đây.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_OCR_MODEL=gemini-3.6-flash
# BazaarLink (OpenAI-compatible) — nhánh embedding chính, fallback Gemini khi 402
BAZAARLINK_API_KEY=
BAZAARLINK_BASE_URL=
BAZAARLINK_EMBEDDING_MODEL=openai/text-embedding-3-small
BAZAARLINK_OCR_MODEL=google/gemini-2.5-flash

# --- Hybrid search (mục 8.E) ---
# Tạo tại https://huggingface.co/settings/tokens (scope "Read" là đủ).
HF_API_KEY=
HF_BASE_URL=https://router.huggingface.co
HF_BGE_MODEL=BAAI/bge-m3
HF_BGE_DIMENSIONS=1024
HF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Timeout (ms) mỗi request HF — free tier có cold start 10-30s khi model chưa "warm".
HF_TIMEOUT_MS=45000
# Đặt =false để tắt nhánh tương ứng khi debug hoặc hết quota.
HF_ENABLE_BGE=true
HF_ENABLE_RERANKER=true
# SigLIP/CLIP: HF Inference Providers không host serverless nhóm model này nữa
# (2025) — nhánh ảnh dùng Gemini vision auto-caption thay thế. Giữ =false.
HF_ENABLE_SIGLIP=false
